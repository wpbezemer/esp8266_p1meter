// Kopieer dit bestand naar secrets.h en vul je eigen WiFi in.
// secrets.h staat in .gitignore en komt dus NIET op GitHub.
//
// Wordt alleen gebruikt als de ESP geen opgeslagen WiFi gegevens heeft
// (bijvoorbeeld na een build met een andere Flash Size). De ESP verbindt dan
// zelf en slaat de gegevens op, in plaats van in het setup netwerk te blijven hangen.
//
// LET OP: deze gegevens zitten in de gecompileerde .bin. Zet een .bin met
// secrets.h dus nooit in een openbare GitHub release.

#define WIFI_FALLBACK_SSID "MijnWiFi"
#define WIFI_FALLBACK_PASS "MijnWachtwoord"
